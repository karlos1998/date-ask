{
	"name": "date-ask",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Ask someone out with a link where \"no\" simply isn't an option.",
	"engines": {
		"node": "^20.19 || ^22.12 || >=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.2.0",
		"@fontsource/shrikhand": "^5.2.0",
		"@libsql/client": "^0.15.0",
		"canvas-confetti": "^1.9.3",
		"drizzle-orm": "^0.44.0",
		"nanoid": "^5.1.0",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@types/canvas-confetti": "^1.9.0",
		"drizzle-kit": "^0.31.0",
		"prettier": "^3.6.0",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.35.0",
		"svelte-check": "^4.2.0",
		"typescript": "^5.8.0",
		"vite": "^7.0.0"
	}
}
